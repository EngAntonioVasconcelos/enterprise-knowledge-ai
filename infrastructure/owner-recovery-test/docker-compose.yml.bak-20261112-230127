services:
  postgres:
    image: postgres:18.6
    container_name: eka-owner-recovery-pg
    restart: unless-stopped
    environment:
      POSTGRES_DB: ${POSTGRES_DB:?POSTGRES_DB is required}
      POSTGRES_USER: ${POSTGRES_USER:?POSTGRES_USER is required}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?POSTGRES_PASSWORD is required}
    ports:
      - "127.0.0.1:1998:5432"
    volumes:
      - eka_recovery_pgdata:/var/lib/postgresql
    networks:
      - eka_recovery_network
    healthcheck:
      test:
        - CMD-SHELL
        - 'pg_isready -U "$${POSTGRES_USER}" -d "$${POSTGRES_DB}"'
      interval: 5s
      timeout: 5s
      retries: 12
      start_period: 10s

volumes:
  eka_recovery_pgdata:
    name: eka_recovery_pgdata

networks:
  eka_recovery_network:
    name: eka_recovery_network
    internal: true