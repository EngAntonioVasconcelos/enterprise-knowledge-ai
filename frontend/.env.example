# Copy to .env.local (never committed) and fill in. See
# docs/development/frontend.md.

# Auth0 "Regular Web Application" for this frontend (not the backend API).
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
# Secret: only in .env.local
AUTH0_CLIENT_SECRET=
# Secret: 32 random bytes in hex, encrypts the session cookie
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
# Must equal OIDC_AUDIENCE in backend/.env: the API the token is for.
AUTH0_AUDIENCE=

# The backend, as the Next.js server reaches it (never the browser).
EKA_API_URL=http://localhost:8000
