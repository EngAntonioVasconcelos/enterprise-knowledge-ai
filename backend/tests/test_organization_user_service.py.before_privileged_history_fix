def test_create_organization_user_creates_user_and_membership(
    db_session,
    organization,
    owner,
):
    user, membership = create_organization_user(
        db_session,
        organization_id=organization.id,
        actor_user_id=owner.id,
        email="employee@example.com",
        full_name="John Smith",
        role="member",
    )

    assert user.id is not None
    assert user.email == "employee@example.com"
    assert user.full_name == "John Smith"
    assert user.is_active is True

    assert membership.id is not None
    assert membership.organization_id == organization.id
    assert membership.user_id == user.id
    assert membership.role == "member"
    assert membership.is_active is True


def test_create_organization_user_reuses_existing_global_user(
    db_session,
    organization,
    owner,
):
    existing_user = User(
        email="employee@example.com",
        full_name="John Smith",
    )
    db_session.add(existing_user)
    db_session.flush()

    user, membership = create_organization_user(
        db_session,
        organization_id=organization.id,
        actor_user_id=owner.id,
        email="EMPLOYEE@example.com",
        full_name="John Smith",
        role="admin",
    )

    assert user.id == existing_user.id
    assert membership.user_id == existing_user.id
    assert membership.role == "admin"

    employee_count = (
        db_session.query(User)
        .filter(User.email == "employee@example.com")
        .count()
    )
    assert employee_count == 1


def test_create_organization_user_rejects_inactive_global_user(
    db_session,
    organization,
    owner,
):
    inactive_user = User(
        email="inactive@example.com",
        full_name="Inactive User",
        is_active=False,
    )
    db_session.add(inactive_user)
    db_session.flush()

    with pytest.raises(
        ValueError,
        match="Cannot add an inactive user",
    ):
        create_organization_user(
            db_session,
            organization_id=organization.id,
            actor_user_id=owner.id,
            email="inactive@example.com",
            full_name="Inactive User",
        )

    assert db_session.query(OrganizationMembership).filter(
        OrganizationMembership.user_id == inactive_user.id
    ).count() == 0


def test_create_organization_user_rejects_duplicate_active_membership(
    db_session,
    organization,
    owner,
):
    existing_user = User(
        email="employee@example.com",
        full_name="John Smith",
    )
    db_session.add(existing_user)
    db_session.flush()

    create_organization_user(
        db_session,
        organization_id=organization.id,
        actor_user_id=owner.id,
        email=existing_user.email,
        full_name=existing_user.full_name,
    )

    with pytest.raises(
        ValueError,
        match="Membership already exists",
    ):
        create_organization_user(
            db_session,
            organization_id=organization.id,
            actor_user_id=owner.id,
            email=existing_user.email,
            full_name=existing_user.full_name,
        )


def test_create_organization_user_reactivates_inactive_membership(
    db_session,
    organization,
    owner,
):
    existing_user = User(
        email="employee@example.com",
        full_name="John Smith",
    )
    db_session.add(existing_user)
    db_session.flush()

    previous_membership = OrganizationMembership(
        organization_id=organization.id,
        user_id=existing_user.id,
        role="viewer",
        is_active=False,
    )
    db_session.add(previous_membership)
    db_session.flush()

    user, membership = create_organization_user(
        db_session,
        organization_id=organization.id,
        actor_user_id=owner.id,
        email=existing_user.email,
        full_name=existing_user.full_name,
        role="member",
    )

    assert user.id == existing_user.id
    assert membership.id == previous_membership.id
    assert membership.is_active is True
    assert membership.role == "member"


def test_create_organization_user_rollback_removes_new_user(
    db_session,
    organization,
    owner,
    monkeypatch,
):
    import app.services.organization_user_service as service

    def fail_membership_creation(*args, **kwargs):
        raise RuntimeError("Simulated membership failure")

    monkeypatch.setattr(
        service,
        "create_membership",
        fail_membership_creation,
    )

    with pytest.raises(
        RuntimeError,
        match="Simulated membership failure",
    ):
        service.create_organization_user(
            db_session,
            organization_id=organization.id,
            actor_user_id=owner.id,
            email="rollback@example.com",
            full_name="Rollback User",
        )

    db_session.rollback()

    assert db_session.query(User).filter_by(
        email="rollback@example.com"
    ).count() == 0


