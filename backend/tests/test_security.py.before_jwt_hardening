def test_reject_incomplete_oidc_configuration(monkeypatch):
    monkeypatch.setattr(
        security.settings,
        "OIDC_ISSUER",
        None,
    )

    with pytest.raises(RuntimeError, match="OIDC configuration is incomplete"):
        security.verify_access_token("unused-token")