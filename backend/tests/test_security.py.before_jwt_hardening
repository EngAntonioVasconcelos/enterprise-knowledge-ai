from datetime import datetime, timedelta, timezone
from types import SimpleNamespace

import jwt
import pytest
from cryptography.hazmat.primitives.asymmetric import rsa

from app.core import security


@pytest.fixture
def rsa_keys():
    private_key = rsa.generate_private_key(
        public_exponent=65537,
        key_size=2048,
    )

    return private_key, private_key.public_key()


@pytest.fixture
def oidc_settings(monkeypatch):
    monkeypatch.setattr(
        security.settings,
        "OIDC_ISSUER",
        "https://identity.example.com/",
    )
    monkeypatch.setattr(
        security.settings,
        "OIDC_AUDIENCE",
        "enterprise-knowledge-api",
    )
    monkeypatch.setattr(
        security.settings,
        "OIDC_JWKS_URL",
        "https://identity.example.com/.well-known/jwks.json",
    )


@pytest.fixture
def valid_token(rsa_keys):
    private_key, _ = rsa_keys

    now = datetime.now(timezone.utc)

    payload = {
        "sub": "external-user-123",
        "iss": "https://identity.example.com/",
        "aud": "enterprise-knowledge-api",
        "iat": now,
        "exp": now + timedelta(minutes=15),
    }

    return jwt.encode(
        payload,
        private_key,
        algorithm="RS256",
    )


def configure_jwks_client(monkeypatch, public_key):
    fake_client = SimpleNamespace(
        get_signing_key_from_jwt=lambda token: SimpleNamespace(
            key=public_key
        )
    )

    monkeypatch.setattr(
        security,
        "get_jwks_client",
        lambda: fake_client,
    )


def test_verify_valid_access_token(
    monkeypatch,
    oidc_settings,
    valid_token,
    rsa_keys,
):
    _, public_key = rsa_keys
    configure_jwks_client(monkeypatch, public_key)

    payload = security.verify_access_token(valid_token)

    assert payload["sub"] == "external-user-123"
    assert payload["iss"] == "https://identity.example.com/"


def test_reject_expired_access_token(
    monkeypatch,
    oidc_settings,
    rsa_keys,
):
    private_key, public_key = rsa_keys
    configure_jwks_client(monkeypatch, public_key)

    now = datetime.now(timezone.utc)

    token = jwt.encode(
        {
            "sub": "external-user-123",
            "iss": "https://identity.example.com/",
            "aud": "enterprise-knowledge-api",
            "exp": now - timedelta(minutes=5),
        },
        private_key,
        algorithm="RS256",
    )

    with pytest.raises(jwt.ExpiredSignatureError):
        security.verify_access_token(token)


def test_reject_wrong_issuer(
    monkeypatch,
    oidc_settings,
    rsa_keys,
):
    private_key, public_key = rsa_keys
    configure_jwks_client(monkeypatch, public_key)

    now = datetime.now(timezone.utc)

    token = jwt.encode(
        {
            "sub": "external-user-123",
            "iss": "https://attacker.example.com/",
            "aud": "enterprise-knowledge-api",
            "exp": now + timedelta(minutes=15),
        },
        private_key,
        algorithm="RS256",
    )

    with pytest.raises(jwt.InvalidIssuerError):
