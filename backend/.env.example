# ==========================================
# Database configuration
# ==========================================

# Application runtime database (restricted role)
DATABASE_URL=postgresql+psycopg://eka_runtime:password@localhost:1997/enterprise_knowledge_ai

# Administrative connection exclusively for Alembic migrations
MIGRATION_DATABASE_URL=postgresql+psycopg://migration_user:password@localhost:1997/enterprise_knowledge_ai


# ==========================================
# CORS configuration
# ==========================================

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]


# ==========================================
# OpenID Connect configuration
# ==========================================

OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_JWKS_TIMEOUT_SECONDS=5
# Prefix of the profile claims added to the access token, e.g.
# https://enterprise-knowledge-ai/ (see docs/development/auth0-setup.md)
OIDC_CLAIMS_NAMESPACE=


# ==========================================
# Invitation e-mails (docs/development/email-outbox.md)
# ==========================================

FRONTEND_BASE_URL=http://localhost:3000
# console prints e-mails; development only
EMAIL_SENDER=console
EMAIL_FROM=Enterprise Knowledge AI <no-reply@localhost>
# Dispatcher login; it must hold the eka_mailer role
MAILER_DATABASE_URL=
