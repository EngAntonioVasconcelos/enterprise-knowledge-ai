# ==========================================
# Database configuration
# ==========================================

# Application runtime database (restricted role)
DATABASE_URL=postgresql+psycopg://eka_runtime:password@localhost:1997/enterprise_knowledge_ai

# Administrative connection exclusively for Alembic migrations
MIGRATION_DATABASE_URL=postgresql+psycopg://migration_user:password@localhost:1997/enterprise_knowledge_ai


# ==========================================
# CORS configuration
# ==========================================

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]


# ==========================================
# OpenID Connect configuration
# ==========================================

OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_JWKS_TIMEOUT_SECONDS=5
# Prefix of the profile claims added to the access token, e.g.
# https://enterprise-knowledge-ai/ (see docs/development/auth0-setup.md)
OIDC_CLAIMS_NAMESPACE=


# ==========================================
# Invitation e-mails (docs/development/email-outbox.md)
# ==========================================

FRONTEND_BASE_URL=http://localhost:3000
# console prints e-mails; development only
EMAIL_SENDER=console
EMAIL_FROM=Enterprise Knowledge AI <no-reply@localhost>
# Dispatcher login; it must hold the eka_mailer role
MAILER_DATABASE_URL=


# ==========================================
# Background worker (docs/development/background-jobs.md)
# ==========================================

# Worker login; it must hold the eka_worker role
WORKER_DATABASE_URL=


# ==========================================
# Connection credentials (ADR-007)
# ==========================================

# Create both with: python -m scripts.generate_master_key
# The API needs only the public key; the worker needs both.
CREDENTIALS_MASTER_PUBLIC_KEY=
CREDENTIALS_MASTER_PRIVATE_KEY=


# ==========================================
# Object storage (ADR-004)
# ==========================================

# local keeps files in a folder; development only
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=var/storage


# ==========================================
# Google Drive (docs/development/google-drive.md)
# ==========================================

# From the Google Cloud console (OAuth client, Web application).
# The API and the worker both need them.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Empty means FRONTEND_BASE_URL/connections/google/callback
GOOGLE_OAUTH_REDIRECT_URI=
# Create with: python -m scripts.generate_state_secret (API only)
OAUTH_STATE_SECRET=


# ==========================================
# Database connectors (docs/development/postgresql-connector.md)
# ==========================================

# true lets connections reach localhost and private networks;
# development only, never in production
DATABASE_CONNECTOR_ALLOW_PRIVATE_HOSTS=false


# ==========================================
# Embeddings (docs/development/embeddings.md)
# ==========================================

# fastembed (local model, free), hashing (tests) or none
EMBEDDING_PROVIDER=fastembed
# Download once with: python -m scripts.try_embeddings
EMBEDDING_CACHE_DIR=var/models

# Reranker (docs/development/reranking.md): fastembed (local model,
# free), overlap (tests) or none. Download once with:
# python -m scripts.try_reranker
RERANK_PROVIDER=fastembed
